# Dependencies (Bun is the canonical package manager; see bun.lock)
node_modules/
package-lock.json

# Build output
frontend/dist/

# Local env / secrets (never commit API keys — env vars only)
.env
.env.*
!.env.example
*.local

# Tool outputs (legacy single-result file; regenerated per run)
bbox_result.json

# Runtime-switchable data-root persistence (server-local paths)
.runtime-state.json

# Runtime logs
logs/
*.log

# Scene data (large point clouds / splats — keep only the dir placeholder)
scenes/*
!scenes/.gitkeep

# Trajectory data (worldmodel flight_*/step_* dirs — large, keep placeholder only)
trajectories/*
!trajectories/.gitkeep

# SceneGraph snapshot data (source + exported — large, keep placeholder only)
scene_graph/*
!scene_graph/.gitkeep

bboxes/

# OS junk
.DS_Store
Thumbs.db